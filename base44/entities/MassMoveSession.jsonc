{
  "name": "MassMoveSession",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "p\u00e5g\u00e5ende",
        "bekr\u00e4ftad"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "p\u00e5g\u00e5ende"
    },
    "lists": {
      "type": "array",
      "description": "Flytt- och s\u00e4ljlistor med f\u00f6rem\u00e5l",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "unplaced": {
      "type": "array",
      "description": "Skannade f\u00f6rem\u00e5l som inte ligger i n\u00e5gon lista",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "unknown": {
      "type": "array",
      "description": "Ej igenk\u00e4nda streckkoder",
      "items": {
        "type": "string"
      }
    },
    "started_by_email": {
      "type": "string"
    },
    "started_by_name": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "nullable": true
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "verktygsf\u00f6rvaltare"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mekaniker"
          }
        },
        {
          "user_condition": {
            "role": "admin_lokalv\u00e5rd"
          }
        },
        {
          "user_condition": {
            "role": "\u00e4gare"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "\u00e4gare"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "\u00e4gare"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "\u00e4gare"
          }
        }
      ]
    }
  }
}